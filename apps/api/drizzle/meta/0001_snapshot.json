        },
        "bookings_amounts_check": {
          "name": "bookings_amounts_check",
          "value": "\"bookings\".\"room_total\" >= 0 AND \"bookings\".\"meals_total\" >= 0 AND \"bookings\".\"commission_amount\" >= 0\n        AND \"bookings\".\"breakfast_price\" >= 0 AND \"bookings\".\"dinner_price\" >= 0\n        AND (\"bookings\".\"room_price_per_night\" IS NULL OR \"bookings\".\"room_price_per_night\" >= 0)"
        },
        "bookings_commission_rate_bp_check": {
          "name": "bookings_commission_rate_bp_check",
          "value": "\"bookings\".\"commission_rate_bp\" >= 0 AND \"bookings\".\"commission_rate_bp\" <= 10000"
        },
        "bookings_commission_le_room_total_check": {
          "name": "bookings_commission_le_room_total_check",
          "value": "\"bookings\".\"commission_amount\" <= \"bookings\".\"room_total\""
        },
        "bookings_source_rules_check": {
          "name": "bookings_source_rules_check",
          "value": "(\"bookings\".\"source\" = 'booking_com' AND \"bookings\".\"breakfast\" = true AND \"bookings\".\"breakfast_price\" = 0)\n        OR (\"bookings\".\"source\" <> 'booking_com' AND \"bookings\".\"commission_rate_bp\" = 0\n            AND \"bookings\".\"commission_amount\" = 0 AND \"bookings\".\"room_price_per_night\" IS NOT NULL)"
        },
        "bookings_payment_check": {
          "name": "bookings_payment_check",
          "value": "(\"bookings\".\"payment_method\" IS NULL) = (\"bookings\".\"paid_at\" IS NULL)"
        }
      },
