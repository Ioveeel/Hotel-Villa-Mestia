        "bookings_dates_check": {
          "name": "bookings_dates_check",
          "value": "\"bookings\".\"check_out\" > \"bookings\".\"check_in\""
        },
        "bookings_adults_check": {
          "name": "bookings_adults_check",
          "value": "\"bookings\".\"adults\" >= 1"
